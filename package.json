{
  "name": "tgb-form",
  "private": true,
  "description": "An easy to use form library, with powerful schema-based form definition capabilities.",
  "homepage": "https://github.com/VueEasyForm/tgb-form#readme",
  "bugs": {
    "url": "https://github.com/VueEasyForm/tgb-form/issues"
  },
  "license": "MIT",
  "author": "The @tgb-form Authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VueEasyForm/tgb-form.git"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:packages": "pnpm -r --filter \"./packages/*\" run test",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "check-types": "turbo run typecheck",
    "check-types:packages": "pnpm -r --filter \"./packages/*\" run typecheck",
    "prepare": "husky",
    "change": "pnpm change",
    "change:status": "pnpm change status",
    "release:version": "pnpm version -r",
    "release": "pnpm build:packages && pnpm publish -r",
    "release:check": "pnpm build:packages && pnpm test:packages && pnpm check-types:packages"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "eslint-plugin-astro": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
